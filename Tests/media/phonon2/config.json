{
  "model_type": "phonon2",
  "target": "nemo.collections.asr.models.rnnt_bpe_models.EncDecRNNTBPEModel",
  "model_defaults": {
    "tdt_durations": [
      0,
      1,
      2
    ]
  },
  "preprocessor": {
    "sample_rate": 16000,
    "normalize": "per_feature",
    "window_size": 0.025,
    "window_stride": 0.01,
    "window": "hann",
    "features": 8,
    "n_fft": 512,
    "dither": 0
  },
  "encoder": {
    "feat_in": 8,
    "n_layers": 1,
    "d_model": 128,
    "n_heads": 4,
    "ff_expansion_factor": 2,
    "subsampling_factor": 2,
    "self_attention_model": "rel_pos",
    "subsampling": "dw_striding",
    "conv_kernel_size": 3,
    "subsampling_conv_channels": 4,
    "pos_emb_max_len": 128,
    "use_bias": false
  },
  "decoder": {
    "blank_as_pad": true,
    "vocab_size": 8,
    "prednet": {
      "pred_hidden": 16,
      "pred_rnn_layers": 1
    }
  },
  "joint": {
    "num_classes": 8,
    "vocabulary": [
      "\u2581word0",
      "\u2581word1",
      "\u2581word2",
      "\u2581word3",
      "\u2581word4",
      "\u2581word5",
      "\u2581word6",
      "\u2581word7"
    ],
    "num_extra_outputs": 3,
    "jointnet": {
      "joint_hidden": 16,
      "activation": "relu",
      "encoder_hidden": 128,
      "pred_hidden": 16
    }
  },
  "decoding": {
    "model_type": "tdt",
    "durations": [
      0,
      1,
      2
    ],
    "greedy": {
      "max_symbols": 4
    }
  },
  "phonon2_modules": [
    {
      "name": "encoder.layers.0.feed_forward1.linear1",
      "shape": [
        256,
        128
      ]
    },
    {
      "name": "encoder.layers.0.feed_forward1.linear2",
      "shape": [
        128,
        256
      ]
    },
    {
      "name": "encoder.layers.0.self_attn.linear_q",
      "shape": [
        128,
        128
      ]
    },
    {
      "name": "encoder.layers.0.self_attn.linear_k",
      "shape": [
        128,
        128
      ]
    },
    {
      "name": "encoder.layers.0.self_attn.linear_v",
      "shape": [
        128,
        128
      ]
    },
    {
      "name": "encoder.layers.0.self_attn.linear_out",
      "shape": [
        128,
        128
      ]
    },
    {
      "name": "encoder.layers.0.self_attn.linear_pos",
      "shape": [
        128,
        128
      ]
    },
    {
      "name": "encoder.layers.0.conv.pointwise_conv1",
      "shape": [
        256,
        128
      ]
    },
    {
      "name": "encoder.layers.0.conv.pointwise_conv2",
      "shape": [
        128,
        128
      ]
    },
    {
      "name": "encoder.layers.0.feed_forward2.linear1",
      "shape": [
        256,
        128
      ]
    },
    {
      "name": "encoder.layers.0.feed_forward2.linear2",
      "shape": [
        128,
        256
      ]
    }
  ]
}
